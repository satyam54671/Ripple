# ==============================================================================
# RIPPLE - AI-Powered Travel Disruption Recovery System
# Copy this file to .env and fill in real credentials when moving beyond mocks.
# ==============================================================================

# --- Application ---
APP_NAME=RIPPLE
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# SQLite default for local development:
DATABASE_URL=sqlite:///./ripple.db
# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://ripple:ripple_secret@localhost:5432/ripple

# --- LLM Configuration (Optional - rule-based & deterministic fallbacks built-in) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4o-mini

# --- Integration Mode ---
# Set to "mock" for deterministic local simulation or "live" when OAuth/API keys exist
INTEGRATION_MODE=mock

# --- Google Workspace (Gmail & Calendar) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- Flight & Travel Provider APIs ---
FLIGHT_STATUS_API_KEY=your_flight_provider_api_key_here
TRAVEL_PROVIDER_API_KEY=your_travel_provider_api_key_here

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
